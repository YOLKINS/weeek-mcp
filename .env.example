# Personal Weeek API token (https://app.weeek.net/ws/_/settings/apps/api).
# Required from I3 onwards. Replace with a real token — startup will reject the
# `your-weeek-token-here` placeholder, whitespace, and control characters.
WEEEK_ACCESS_TOKEN=your-weeek-token-here

# Weeek public API base URL. Override only if you run a self-hosted proxy.
WEEEK_BASE_URL=https://api.weeek.net/public/v1

# Per-request timeout for the Weeek HTTP client (ms). Default: 30000.
WEEEK_TIMEOUT_MS=30000

# Server-side gate: when `true` (default, secure-by-default), any tool whose
# annotations.readOnlyHint !== true is skipped at registration and is not
# advertised in tools/list. Accepts: true|false|1|0 (case-insensitive).
#
# SINCE I8 THIS GATE IS LOAD-BEARING. The server ships 5 mutating tools
# (weeek_complete_task, weeek_move_task, weeek_create_task, weeek_update_task,
# weeek_set_task_mr_link) and READ_ONLY=true is the only thing keeping them out
# of tools/list: 10 tools under `true`, 15 under `false`. Setting it to false
# lets an agent create, edit, move and complete tasks in whatever workspace the
# token reaches — there is no server-side confirmation step. Leave it alone
# unless you mean it; see the READMEs' "Enabling write tools" section.
READ_ONLY=true

# Optional comma-separated allowlist of tool names. When set, only listed
# tools are registered (still intersected with READ_ONLY). Whitespace is
# trimmed, duplicates are deduped, empty/whitespace-only values abort startup.
# Unknown names emit a WARN at startup; if the resulting set is empty, the
# server aborts before opening stdio. Leave commented out to expose all
# (READ_ONLY-gated) tools.
# ENABLED_TOOLS=weeek_get_me,weeek_list_projects
#
# The recommended way to try writes: flip READ_ONLY above to `false` and set
# the allowlist below, so writes are on but exactly one write tool is exposed
# — the completion toggle, whose whole effect is one boolean and which is
# undone by re-firing it with completed:false. Name the read tools you also
# want; the allowlist is not additive.
# ENABLED_TOOLS=weeek_get_task,weeek_list_tasks,weeek_complete_task

# Upper bound on JSON.stringify(structuredContent).length per tool response.
# Every tool except `ping` and `weeek_get_me` clips its payload to fit within
# this budget and reports `truncated: true` in `structuredContent` — the eight
# gated read tools (`weeek_list_projects`, `weeek_get_project`,
# `weeek_list_tasks`, `weeek_get_task`, `weeek_list_members`, `weeek_list_tags`,
# `weeek_list_boards`, `weeek_list_board_columns`) plus, since I8, the five
# write tools, which return the task-detail shape and inherit the same signal.
# Lists drop trailing items; the task / project detail shapes clip the
# `description` field with a trailing `…[truncated]` marker. Default 65536 (~16-20K tokens) covers the
# common case; raise it for enterprise workspaces with large lists. Min 1024
# (room for the envelope), max 1 000 000 (typo guard). Unlike ENABLED_TOOLS
# this block is uncommented because the default value is safe.
MAX_RESPONSE_CHARS=65536
