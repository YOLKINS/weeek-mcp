{
  "name": "weeek-mcp",
  "version": "1.0.0",
  "private": false,
  "description": "Local MCP server for Weeek (stdio transport) — read-only by default, opt-in write tools.",
  "mcpName": "io.github.YOLKINS/weeek-mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "weeek",
    "claude",
    "cursor",
    "ai-agents",
    "llm-tools",
    "stdio"
  ],
  "license": "MIT",
  "author": "yolochkas <yolochkas@proton.me>",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOLKINS/weeek-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/YOLKINS/weeek-mcp/issues"
  },
  "homepage": "https://github.com/YOLKINS/weeek-mcp#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "weeek-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm run typecheck:tests && npm run lint && npm test && npm run coverage && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
